{
	"name": "@spider-cloud/n8n-nodes-spider",
	"version": "1.0.5",
	"description": "n8n community node for Spider: scrape, crawl and search the web as markdown for AI agents and workflows",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"spider",
		"web-scraping",
		"web-crawler",
		"scraper",
		"crawler",
		"markdown",
		"search",
		"screenshot",
		"ai-agent",
		"rag"
	],
	"license": "MIT",
	"homepage": "https://github.com/spider-rs/n8n-nodes-spider#readme",
	"author": {
		"name": "William Espegren",
		"email": "espegren.w@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/spider-rs/n8n-nodes-spider.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "n8n-node build && node --test test/node.test.cjs"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SpiderApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Spider/Spider.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.56.1",
		"eslint": "^9.0.0",
		"prettier": "^3.2.5",
		"release-it": "^17.1.1",
		"typescript": "^5.3.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	},
	"bugs": {
		"url": "https://github.com/spider-rs/n8n-nodes-spider/issues"
	}
}
